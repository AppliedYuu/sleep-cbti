# 复制本文件为 .env 并根据环境填写。.env 已被 .gitignore 忽略，禁止提交。

# ===== 数据库 =====
# 方式一（推荐）：云数据库连接串（MySQL）
# DATABASE_URL=mysql://user:password@host:port/dbname
# 方式二：本地 MySQL（XAMPP 等），取消下面注释
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sleep_cbti

# 服务端口
PORT=3000

# JWT 密钥（必须改为随机长字符串，生产环境用环境变量注入）
JWT_SECRET=please-change-this-to-a-long-random-string

# DeepSeek AI（可选，不填则 AI 助手不可用）
DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 环境（development / production）
NODE_ENV=development

# 可选：额外允许的 CORS 前端域名（逗号分隔），默认已含 localhost 开发地址
# CORS_ORIGINS=https://example.github.io
